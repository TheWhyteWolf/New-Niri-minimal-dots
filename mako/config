# ╔══════════════════════════════════════════════╗
# ║  mako/config                                ║
# ╚══════════════════════════════════════════════╝

sort=-time
layer=overlay
anchor=top-right

# Geometry
width=260
height=90
margin=14
padding=8,8

# Style. Colours: theme, generated by `theme` from the palette in use. mako
# only allows include= outside sections, so it stays up here.
include=~/.config/mako/theme
border-size=2
border-radius=8

# Icons
icons=1
max-icon-size=44
icon-path=/usr/share/icons/Papirus-Dark

# Text
font=JetBrainsMono Nerd Font 9
markup=1
actions=1
format=<b>%s</b>\n%b

# Behaviour
default-timeout=5000
ignore-timeout=0
max-visible=5

# Progress bar (für media notifications)
[hidden]
format=(+%i more)

[urgency=low]
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=high]
default-timeout=0
