# Generated by `theme` from {{name}}; edits are overwritten.
# Template: themes/templates/btop.theme (btop.conf: color_theme = "current").
theme[main_bg]="{{term_bg}}"
theme[main_fg]="{{term_fg}}"
theme[title]="{{accent}}"
theme[hi_fg]="{{accent2}}"
theme[selected_bg]="{{overlay}}"
theme[selected_fg]="{{accent}}"
theme[inactive_fg]="{{muted}}"
theme[graph_text]="{{subtext}}"
theme[meter_bg]="{{overlay}}"
theme[proc_misc]="{{accent2}}"
theme[cpu_box]="{{accent}}"
theme[mem_box]="{{accent2}}"
theme[net_box]="{{accent3}}"
theme[proc_box]="{{accent}}"
theme[div_line]="{{overlay}}"
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{red}}"
theme[cpu_start]="{{gradient1}}"
theme[cpu_mid]="{{gradient4}}"
theme[cpu_end]="{{gradient8}}"
theme[free_start]="{{green}}"
theme[free_mid]="{{cyan}}"
theme[free_end]="{{blue}}"
theme[cached_start]="{{blue}}"
theme[cached_mid]="{{cyan}}"
theme[cached_end]="{{accent2}}"
theme[available_start]="{{yellow}}"
theme[available_mid]="{{orange}}"
theme[available_end]="{{red}}"
theme[used_start]="{{accent3}}"
theme[used_mid]="{{magenta}}"
theme[used_end]="{{red}}"
theme[download_start]="{{gradient1}}"
theme[download_mid]="{{gradient3}}"
theme[download_end]="{{gradient5}}"
theme[upload_start]="{{gradient4}}"
theme[upload_mid]="{{gradient6}}"
theme[upload_end]="{{gradient8}}"
theme[process_start]="{{accent2}}"
theme[process_mid]="{{accent}}"
theme[process_end]="{{accent3}}"
