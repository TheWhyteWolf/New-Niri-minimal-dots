// Generated by `theme` from {{name}}; edits are overwritten.
// Template: themes/templates/niri.kdl. config.kdl includes this last, so these
// colours win; whether the ring, border and shadow are on stays up to config.kdl.
layout {
    focus-ring {
        active-color "{{accent}}"
        inactive-color "{{border_inactive}}"
        urgent-color "{{urgent}}"
    }
    border {
        active-color "{{border}}"
        inactive-color "{{border_inactive}}"
        urgent-color "{{urgent}}"
    }
    tab-indicator {
        active-color "{{accent}}"
        inactive-color "{{overlay}}"
        urgent-color "{{urgent}}"
    }
    insert-hint {
        color "#{{accent.hex}}70"
    }
    shadow {
        color "#{{crust.hex}}70"
    }
}

overview {
    backdrop-color "{{bg}}"
}
