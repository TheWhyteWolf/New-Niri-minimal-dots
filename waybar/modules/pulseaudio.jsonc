{
  // ───────── Audio ─────────
  // Reference: "🔊 30%" — icon + percentage only, no source/mic module in the bar.
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": "󰂯 󰝟 {volume}%",
    "format-source": "",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏀" ,
      "portable": "󰥤",
      "car": "󰄋"
    },
    "scroll-step": 5,
    "on-click": "~/.config/waybar/scripts/volume-control.sh",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "Volume: {volume}%\n{desc}",
    "smooth-scrolling-threshold": 1
  }
}